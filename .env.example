# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-secret

# Puter (https://puter.com) — login + AI models in one integration.
# Create an API token: https://puter.com/dashboard -> "Create token".
# With this set, the built-in model catalog switches to Puter models and the
# server can fall back to your token when a user has not signed in with Puter.
PUTER_AUTH_TOKEN=

# Optional: custom Puter API origin / OpenAI-compatible base URL.
# PUTER_API_ORIGIN=https://api.puter.com
# PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/

# Direct OpenAI-compatible endpoint (recommended for BYOK).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Vercel AI Gateway fallback when OPENAI_API_KEY is empty.
AI_GATEWAY_API_KEY=

# Optional multiple OpenAI-compatible providers. Keep keys server-side only.
# Model ids use the provider prefix, e.g. groq/llama-3.3-70b-versatile.
AI_PROVIDER_CONFIG_JSON={"groq":{"apiKey":"gsk_replace_me","baseURL":"https://api.groq.com/openai/v1"},"openrouter":{"apiKey":"sk-or-replace_me","baseURL":"https://openrouter.ai/api/v1"}}

# Optional model catalog. The first model becomes the default.
# Puter example:
AI_MODELS_JSON=[{"id":"puter/gpt-5.4-nano","name":"GPT-5.4 nano","provider":"puter","description":"Fast general-purpose model"},{"id":"puter/claude-sonnet-5","name":"Claude Sonnet 5","provider":"puter","description":"Anthropic model via Puter"}]
AI_TITLE_MODEL=puter/gpt-4o-mini

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Set to 1 only for the public demo mode.
IS_DEMO=0
